{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "commercial-corpus-manifest.schema.json",
  "title": "AGF commercial corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "corpus_content_revision",
    "provenance",
    "source_inventory",
    "included",
    "excluded",
    "corpus_set_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "corpus_version": {
      "type": "integer",
      "minimum": 1
    },
    "corpus_content_revision": {
      "$ref": "#/definitions/commit_sha"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_inventory_commit", "cl3_decision"],
      "properties": {
        "source_inventory_commit": {
          "$ref": "#/definitions/commit_sha"
        },
        "cl3_decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/definitions/repository_path"
        }
      }
    },
    "included": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "$ref": "#/definitions/repository_path"
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "source"],
        "properties": {
          "path": {
            "$ref": "#/definitions/repository_path"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "inventory",
              "post-inventory-governor-decision"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "post-inventory-governor-decision"
                }
              }
            },
            "then": {
              "required": ["decision"]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "inventory"
                }
              }
            },
            "then": {
              "not": {
                "required": ["decision"]
              }
            }
          }
        ]
      }
    },
    "corpus_set_digest": {
      "$ref": "#/definitions/sha256"
    }
  },
  "definitions": {
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
