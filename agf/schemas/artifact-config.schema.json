{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-config.schema.json",
  "title": "Optional generic artifact registry v1",
  "type": "object",
  "properties": {
    "artifact_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "paths",
          "schema",
          "id_pointers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "id_pointers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reference_pointers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "dependency_pointers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "uniqueness_scope": {
            "enum": [
              "global"
            ],
            "default": "global"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
