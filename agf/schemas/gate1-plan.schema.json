{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate1-plan.schema.json",
  "title": "Gate 1 Plan",
  "description": "Front matter schema for AGF-NG Gate 1 plan files (docs/plans/*.md)",
  "type": "object",
  "required": [
    "id",
    "status",
    "advisory_consultation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending-gate1",
        "approved",
        "active",
        "complete",
        "superseded"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "gate1_approved_by": {
      "type": "string"
    },
    "gate1_approved_at": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier (plan id, or the id of the replacement work item/work order) of what replaced this plan. Required only when status is superseded."
    },
    "superseded_decision": {
      "type": "string",
      "minLength": 1,
      "description": "Filename or id of the governor-reviewer coordination decision-record authorizing this disposition. Required only when status is superseded."
    },
    "superseded_at": {
      "type": "string",
      "minLength": 1,
      "description": "UTC disposition timestamp (RFC3339). Required only when status is superseded."
    },
    "advisory_consultation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "status"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "consulted",
              "waived",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "waived"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "affected_paths": {
      "type": "array",
      "description": "Optional repository-relative paths/globs; ** is allowed only as a whole path segment. Overlap checking is advisory.",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[^/]\\*\\*)(?!.*\\*\\*[^/]).+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by",
          "superseded_decision",
          "superseded_at"
        ]
      }
    }
  ]
}
