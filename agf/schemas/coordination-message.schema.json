{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coordination-message.schema.json",
  "title": "Coordination Message",
  "description": "Front matter schema for AGF-NG coordination channel messages (docs/coordination/*.md)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "from",
    "to",
    "timestamp",
    "immutable",
    "references-to",
    "topic",
    "requires-ack"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "claim",
        "completion",
        "review",
        "ack",
        "handoff",
        "decision-record",
        "fast-track-waiver",
        "lesson-proposal",
        "note"
      ]
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "Role identifier from MANIFEST.yaml (e.g. planner-architect, human). Not a model name."
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "description": "Role identifier from MANIFEST.yaml, or 'all'. Not a model name."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "x-deprecated": true,
      "description": "Deprecated. Advisory only — do NOT assign as a global counter. Causal ordering belongs in references-to and timestamp. Kept for backward compatibility with existing channels."
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*-[a-z0-9]{4,6}|[A-Za-z0-9][A-Za-z0-9._:-]{3,127})$",
      "description": "Coordination message identifier. Prefer a readable ID in YYYYMMDDThhmmssZ-<role-slug>-<random-suffix> form generated by AGF tooling. Legacy ULIDs remain valid. Manual IDs are valid only when they match the constrained filename-safe pattern and pass uniqueness validation."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "immutable": {
      "type": "boolean",
      "const": true
    },
    "references-to": {
      "type": "array",
      "items": { "type": "string" }
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "requires-ack": {
      "type": "boolean"
    },
    "artifacts_owned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "LLM instance that produced this message (e.g. claude-sonnet-4-6). Optional. Provenance only — never used for routing."
    },
    "session": {
      "type": "string",
      "minLength": 1,
      "description": "UUIDv7 session identifier. A new session begins when an agent invocation starts writing to the channel. Optional. Audit only."
    },
    "expires_on": {
      "type": "string",
      "description": "Optional ISO 8601 timestamp. On a claim message, ownership is considered stale after this time if no release has been posted. Ignored on all other message kinds."
    },
    "handoff": {
      "type": "object",
      "required": ["next_agent", "status", "task", "must_read", "do_not_touch"],
      "properties": {
        "next_agent": { "type": "string", "minLength": 1 },
        "status":     { "type": "string", "enum": ["ready", "blocked"] },
        "task":       { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "must_read":  { "type": "array", "items": { "type": "string" } },
        "do_not_touch": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "convergence": {
      "type": "object",
      "required": ["series_id", "event", "invariant_ids"],
      "properties": {
        "series_id": {
          "type": "string",
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*-[a-z0-9]{4,6}|[A-Za-z0-9][A-Za-z0-9._:-]{3,127})$"
        },
        "event": {
          "type": "string",
          "enum": ["candidate", "targeted-review", "abstraction-reset", "governor-disposition"]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "invariant_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "scope_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_event": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": ["clear", "block", "advisory"]
        },
        "materiality_basis": {
          "type": "string",
          "enum": [
            "mandatory-acceptance-criterion",
            "security-privacy-integrity-boundary",
            "compatibility-operator-safety-promise",
            "required-governed-artifact"
          ]
        },
        "authority_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "disposition": {
          "type": "string",
          "enum": ["redesign", "accept", "rescope", "defer", "stop"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "candidate" } }, "required": ["event"] },
          "then": {
            "required": ["attempt", "candidate_sha", "scope_paths", "scope_digest"]
          }
        },
        {
          "if": { "properties": { "event": { "const": "targeted-review" } }, "required": ["event"] },
          "then": {
            "required": ["attempt", "candidate_sha", "scope_paths", "scope_digest", "candidate_event", "outcome"]
          }
        },
        {
          "if": {
            "properties": {
              "event": { "const": "targeted-review" },
              "outcome": { "const": "block" }
            },
            "required": ["event", "outcome"]
          },
          "then": {
            "required": ["materiality_basis", "authority_ref", "evidence_refs"]
          }
        },
        {
          "if": { "properties": { "event": { "const": "abstraction-reset" } }, "required": ["event"] },
          "then": {
            "required": ["disposition"],
            "properties": {
              "disposition": { "enum": ["redesign", "accept", "defer", "stop"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": { "const": "abstraction-reset" },
              "disposition": { "enum": ["accept", "defer", "stop"] }
            },
            "required": ["event", "disposition"]
          },
          "then": { "required": ["authority_ref"] }
        },
        {
          "if": { "properties": { "event": { "const": "governor-disposition" } }, "required": ["event"] },
          "then": {
            "required": ["disposition", "authority_ref"],
            "properties": {
              "disposition": { "enum": ["accept", "rescope", "defer", "stop"] }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if":   { "properties": { "kind": { "const": "claim" } }, "required": ["kind"] },
      "then": { "required": ["artifacts_owned"], "properties": { "artifacts_owned": { "minItems": 1 } } }
    },
    {
      "if":   { "properties": { "kind": { "const": "completion" } }, "required": ["kind"] },
      "then": { "properties": { "artifacts_owned": { "maxItems": 0 } } }
    },
    {
      "if":   { "properties": { "kind": { "const": "ack" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "references-to": { "minItems": 1 },
          "requires-ack": { "const": false }
        }
      }
    },
    {
      "if":   { "properties": { "kind": { "const": "handoff" } }, "required": ["kind"] },
      "then": { "required": ["handoff"] }
    }
  ]
}
