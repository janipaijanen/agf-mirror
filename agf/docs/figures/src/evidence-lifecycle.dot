// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: evidence lifecycle (incident → learning → improvement)
// Generate: dot -Tsvg evidence-lifecycle.dot -o ../evidence-lifecycle.svg
digraph evidence_lifecycle {
    graph [rankdir=TB, splines=spline, pad=0.3, nodesep=0.5, ranksep=0.6,
           bgcolor=white, fontname="Helvetica", fontsize=12]
    node  [fontname="Helvetica", fontsize=11, style=filled, shape=box,
           fillcolor="#99CCEE", color="#0077BB", penwidth=1.4]
    edge  [fontname="Helvetica", fontsize=10, color="#0077BB", penwidth=1.4]

    incident  [label="Incident /\nObservation", shape=ellipse,
               fillcolor="#EE7700", fontcolor=white, color="#EE7700"]
    learning  [label="Learning record\n(learnings/)", fillcolor="#99CCEE"]
    rule      [label="Rule change\n(rules/)", fillcolor="#99CCEE"]
    tool      [label="Validator /\nCI check", fillcolor="#99CCEE"]
    doc       [label="Documentation\nupdate", fillcolor="#99CCEE"]
    promoted  [label="Promoted to\nRecommended", fillcolor="#009944",
               fontcolor=white, color="#009944"]

    incident -> learning [label="documented\nas learning"]
    learning -> rule     [label="single-adopter\nevidence"]
    learning -> tool     [label="automatable\nconstraint"]
    learning -> doc      [label="documentation\ngap"]
    rule     -> promoted [label="2+ adopter\ncorroboration"]
    tool     -> promoted [style=dashed, label="validated\nin CI"]

    {rank=same; rule tool doc}

    legend [shape=plain, label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#888888" BGCOLOR="white">
            <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
            <TR><TD BGCOLOR="#EE7700" WIDTH="28"></TD><TD ALIGN="LEFT">incident / observation (oval shape)</TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28"></TD><TD ALIGN="LEFT">record or candidate change</TD></TR>
            <TR><TD BGCOLOR="#009944" WIDTH="28"></TD><TD ALIGN="LEFT">promoted / recommended</TD></TR>
            <TR><TD><FONT COLOR="#0077BB">-----&gt;</FONT></TD><TD ALIGN="LEFT">evidence-derived change</TD></TR>
            <TR><TD><FONT COLOR="#0077BB">- - -&gt;</FONT></TD><TD ALIGN="LEFT">optional validation path</TD></TR>
        </TABLE>
    >]
    {rank=same; legend; incident}
}
