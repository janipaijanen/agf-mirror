// agents-govern: evidence lifecycle (incident → learning → improvement)
// Generate: dot -Tsvg evidence-lifecycle.dot -o ../evidence-lifecycle.svg
digraph evidence_lifecycle {
    graph [rankdir=LR, splines=spline, pad=0.3, nodesep=0.5, ranksep=0.6,
           fontname="Helvetica", fontsize=11]
    node  [fontname="Helvetica", fontsize=10, style=filled, shape=box,
           fillcolor="#99CCEE", color="#0077BB", penwidth=1.2]
    edge  [fontname="Helvetica", fontsize=9, color="#0077BB", penwidth=1.2]

    incident  [label="Incident /\nObservation", shape=ellipse,
               fillcolor="#EE7700", fontcolor=white, color="#EE7700"]
    learning  [label="Learning record\n(learnings/)", fillcolor="#99CCEE"]
    rule      [label="Rule change\n(rules/)", fillcolor="#99CCEE"]
    tool      [label="Validator /\nCI check", fillcolor="#99CCEE"]
    doc       [label="Documentation\nupdate", fillcolor="#99CCEE"]
    promoted  [label="Promoted to\nRecommended", fillcolor="#009944",
               fontcolor=white, color="#009944"]

    incident -> learning [label="documented\nas learning"]
    learning -> rule     [label="single-adopter\nevidence"]
    learning -> tool     [label="automatable\nconstraint"]
    learning -> doc      [label="documentation\ngap"]
    rule     -> promoted [label="2+ adopter\ncorroboration"]
    tool     -> promoted [style=dashed, label="validated\nin CI"]

    {rank=same; rule tool doc}
}
