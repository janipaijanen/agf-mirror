// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: example AGF foundry coordination map
// Generate: dot -Tsvg coordination-map-example.dot -o ../coordination-map-example.svg
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section). This figure previously
// used an unrelated Atlassian-style colour set (#42526e, #3367d6,
// #6554c0, #ff8b00, #00875a) -- exactly the "three unrelated palette
// families" defect the workstream inventory identified. Role nodes now
// use the same AI-action / Human-decision hues as coordination-
// channel.dot's agent treatment (ellipse shape, coloured by role type);
// the "all" broadcast target is the neutral trigger/destination ellipse
// used throughout this figure set. Edge colours map onto the existing
// message-kind convention: handoff = AI action blue, decision-record /
// ack = approved-outcome green, note = advisory grey (dashed).
digraph agf_coordination_example {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    fontname="Helvetica",
    label="Example AGF Foundry Coordination Map",
    labelloc=t,
    fontsize=14
  ];
  node [
    fontname="Helvetica",
    fontsize=11,
    shape=ellipse,
    style=filled,
    color="#0077BB",
    fillcolor="#99CCEE",
    fontcolor="#1A1A1A",
    penwidth=1.4
  ];
  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.8,
    penwidth=1.4
  ];

  // Shape key: same responsibility categories used across this figure
  // set, applied here to coordination-channel participants.
  subgraph cluster_shapekey {
    label = "Legend (responsibility / shape)";
    fontname = "Helvetica";
    fontsize = 12;
    color = "#888888";
    margin = 12;

    sk_ai      [label="AI action\n(agent role)", shape=ellipse,
                fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"];
    sk_human   [label="human decision\n(governor approval role)", shape=ellipse,
                fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"];
    sk_neutral [label="broadcast\ntarget", shape=ellipse,
                fillcolor=white, color="#888888", fontcolor="#1A1A1A"];

    sk_ai -> sk_human -> sk_neutral [style=invis];
  }

  "all" [
    label="all\nbroadcast",
    fillcolor=white,
    color="#888888",
    fontcolor="#1A1A1A"
  ];
  "coder-tester" [
    label="coder-tester"
  ];
  "governor-reviewer" [
    label="governor-reviewer\napproval authority",
    fillcolor="#EE7700",
    color="#EE7700",
    fontcolor="#1A1A1A",
    penwidth=1.8
  ];
  "planner-architect" [
    label="planner-architect"
  ];

  // Stack the shape key above the diagram, same technique as the other
  // converted figures.
  sk_neutral -> "all" [style=invis];

  "coder-tester" -> "governor-reviewer" [
    label="handoff (22)",
    color="#0077BB",
    penwidth=2.2
  ];
  "coder-tester" -> "planner-architect" [
    label="handoff (16)",
    color="#0077BB",
    penwidth=1.9
  ];
  "governor-reviewer" -> "all" [
    label="decision-record (9)",
    color="#009944",
    penwidth=1.7
  ];
  "governor-reviewer" -> "coder-tester" [
    label="ack (9)",
    color="#009944",
    penwidth=1.7
  ];
  "planner-architect" -> "all" [
    label="note (14)",
    style=dashed,
    color="#888888",
    penwidth=1.8
  ];
  "planner-architect" -> "coder-tester" [
    label="handoff (11)",
    color="#0077BB",
    penwidth=1.7
  ];
  "planner-architect" -> "governor-reviewer" [
    label="handoff (8)",
    color="#0077BB",
    penwidth=1.6
  ];
}
