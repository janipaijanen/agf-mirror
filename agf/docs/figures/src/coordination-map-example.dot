// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: example AGF foundry coordination map
// Generate: dot -Tsvg coordination-map-example.dot -o ../coordination-map-example.svg
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section). This figure previously
// used an unrelated Atlassian-style colour set (#42526e, #3367d6,
// #6554c0, #ff8b00, #00875a) -- exactly the "three unrelated palette
// families" defect the workstream inventory identified.
//
// Gate 2 review `20260722T211822Z-contribution-auditor-ghng` (BLOCK 1)
// found two further defects in an earlier converted version of this
// figure: (1) the legend called ellipse participant nodes "AI action"
// and "human decision" -- the palette contract's responsibility-
// category names, which are reserved for its own diamond/rounded-box
// shapes; using them on ellipses contradicts the shape/category
// correspondence the contract requires. (2) aggregate decision-record
// and ack edges were coloured green as an "approved outcome," but these
// message kinds and their counts do not prove every underlying record
// was approved -- coordination-message.schema.json does not bind kind
// to outcome.
//
// Fix: participant nodes use the role-category vocabulary ("AI-primary
// role" / "human-primary role"), the same axis and wording used in
// coordination-channel.dot and docs/academic/figures/src/role-
// communication-topology.dot -- not the responsibility-category names.
// All coordination edges use one neutral, uniform treatment (solid
// blue-mid), varying only by penwidth (message volume, an observed
// count) and label text (kind + count) -- no colour or line-style
// implies approval, automation, or deferred status for any message
// kind.
digraph agf_coordination_example {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    fontname="Helvetica",
    label="Example AGF Foundry Coordination Map",
    labelloc=t,
    fontsize=14
  ];
  node [
    fontname="Helvetica",
    fontsize=11,
    shape=ellipse,
    style=filled,
    color="#0077BB",
    fillcolor="#99CCEE",
    fontcolor="#1A1A1A",
    penwidth=1.4
  ];
  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.8,
    penwidth=1.4
  ];

  // Shape key: role-category axis (who the participant is), not the
  // responsibility-category axis (which node shapes this figure does
  // not use at all -- every node here is a participant, not an event).
  subgraph cluster_shapekey {
    label = "Legend (role category / fill)";
    fontname = "Helvetica";
    fontsize = 12;
    color = "#888888";
    margin = 12;

    sk_ai_role    [label="AI-primary role\n(participant)", shape=ellipse,
                   fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"];
    sk_human_role [label="human-primary role\n(participant)", shape=ellipse,
                   fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"];
    sk_neutral    [label="broadcast\ntarget", shape=ellipse,
                   fillcolor=white, color="#888888", fontcolor="#1A1A1A"];

    sk_ai_role -> sk_human_role -> sk_neutral [style=invis];
  }

  "all" [
    label="all\nbroadcast",
    fillcolor=white,
    color="#888888",
    fontcolor="#1A1A1A"
  ];
  "coder-tester" [
    label="coder-tester"
  ];
  "governor-reviewer" [
    label="governor-reviewer\napproval authority",
    fillcolor="#EE7700",
    color="#EE7700",
    fontcolor="#1A1A1A",
    penwidth=1.8
  ];
  "planner-architect" [
    label="planner-architect"
  ];

  // Stack the shape key above the diagram, same technique as the other
  // converted figures.
  sk_neutral -> "all" [style=invis];

  "coder-tester" -> "governor-reviewer" [
    label="handoff (22)",
    penwidth=2.2
  ];
  "coder-tester" -> "planner-architect" [
    label="handoff (16)",
    penwidth=1.9
  ];
  "governor-reviewer" -> "all" [
    label="decision-record (9)",
    penwidth=1.7
  ];
  "governor-reviewer" -> "coder-tester" [
    label="ack (9)",
    penwidth=1.7
  ];
  "planner-architect" -> "all" [
    label="note (14)",
    penwidth=1.8
  ];
  "planner-architect" -> "coder-tester" [
    label="handoff (11)",
    penwidth=1.7
  ];
  "planner-architect" -> "governor-reviewer" [
    label="handoff (8)",
    penwidth=1.6
  ];
}
