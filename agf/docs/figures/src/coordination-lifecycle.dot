// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: governed-change coordination lifecycle
// Generate: dot -Tsvg coordination-lifecycle.dot -o ../coordination-lifecycle.svg
digraph coordination_lifecycle {
    graph [rankdir=TB, bgcolor=white, pad=0.25, fontname="Helvetica",
           fontsize=12]
    node [shape=plain, fontname="Helvetica", fontsize=11]

    lifecycle [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#888888">
            <TR>
                <TD BGCOLOR="#99CCEE"><B>planner-architect</B></TD>
                <TD BGCOLOR="#99CCEE"><B>coder-tester</B></TD>
                <TD BGCOLOR="#99CCEE"><B>governor-reviewer</B></TD>
            </TR>
            <TR>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT COLOR="#0077BB">handoff (Gate 1 plan approved) &rarr;</FONT></TD>
                <TD></TD>
            </TR>
            <TR>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT COLOR="#0077BB">&larr; ack</FONT></TD>
                <TD></TD>
            </TR>
            <TR>
                <TD></TD>
                <TD BGCOLOR="#99CCEE" ALIGN="CENTER">implement</TD>
                <TD></TD>
            </TR>
            <TR>
                <TD></TD>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT COLOR="#0077BB">handoff (Gate 2) &rarr;</FONT></TD>
            </TR>
            <TR>
                <TD></TD>
                <TD></TD>
                <TD BGCOLOR="#99CCEE" ALIGN="CENTER">review</TD>
            </TR>
            <TR>
                <TD></TD>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT COLOR="#009944">&larr; decision-record</FONT></TD>
            </TR>
            <TR>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT COLOR="#009944">&larr; completion</FONT></TD>
                <TD></TD>
            </TR>
        </TABLE>
    >]

    legend [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="4" COLOR="#888888" BGCOLOR="white">
            <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28"></TD><TD ALIGN="LEFT">local work performed by that role</TD></TR>
            <TR><TD><FONT COLOR="#0077BB">message</FONT></TD><TD ALIGN="LEFT">coordination message</TD></TR>
            <TR><TD><FONT COLOR="#009944">message</FONT></TD><TD ALIGN="LEFT">decision or closure message</TD></TR>
        </TABLE>
    >]

    lifecycle -> legend [style=invis]
}
