// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: day-to-day responsibility modes
// Generate: dot -Tsvg operating-responsibility-map.dot -o ../operating-responsibility-map.svg
digraph operating_responsibility_map {
    graph [rankdir=TB, splines=spline, pad=0.35, nodesep=0.45, ranksep=0.65,
           bgcolor=white, fontname="Helvetica", fontsize=12, compound=true]
    node  [fontname="Helvetica", fontsize=11, style=filled, shape=box,
           fillcolor=white, color="#0077BB", penwidth=1.4]
    edge  [fontname="Helvetica", fontsize=10, color="#0077BB", penwidth=1.4]

    legend [shape=plain, label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#888888" BGCOLOR="white">
            <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
            <TR><TD BORDER="1" COLOR="#0077BB" WIDTH="28"></TD><TD ALIGN="LEFT">mixed human + AI</TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28"></TD><TD ALIGN="LEFT">AI-executed delegated work</TD></TR>
            <TR><TD BGCOLOR="#EE7700" WIDTH="28"></TD><TD ALIGN="LEFT">human-only authority (diamond shape)</TD></TR>
            <TR><TD><FONT COLOR="#009944">-----&gt;</FONT></TD><TD ALIGN="LEFT">approved decision</TD></TR>
            <TR><TD><FONT COLOR="#EE7700">- - -&gt;</FONT></TD><TD ALIGN="LEFT">changes requested</TD></TR>
            <TR><TD><FONT COLOR="#888888">-----&gt;</FONT></TD><TD ALIGN="LEFT">next-cycle feedback</TD></TR>
        </TABLE>
    >]

    read    [label="1. Read, claim,\nand size\n(Mixed)", fillcolor=white]
    execute [label="2. Draft, implement,\ntest, validate\n(AI-executed)",
             fillcolor="#99CCEE"]
    decide  [label="3. Approve,\nreject, or accept risk\n(Human-only)",
             shape=diamond, fillcolor="#EE7700", fontcolor=white,
             color="#EE7700"]
    record  [label="4. Record decision,\ncompletion, or learning\n(Mixed)",
             fillcolor=white]

    read -> execute [label="delegation"]
    execute -> decide [label="handoff\nwith evidence"]
    decide -> execute [label="changes\nrequested", style=dashed,
                       color="#EE7700", fontcolor="#EE7700"]
    decide -> record [label="decision", color="#009944",
                      fontcolor="#009944"]
    record -> read [label="next cycle", color="#888888",
                    fontcolor="#888888"]

    {rank=same; legend; read}
    legend -> read [style=invis]
}
