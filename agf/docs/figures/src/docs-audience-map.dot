// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: documentation map by audience and use
// Generate: dot -Tsvg docs-audience-map.dot -o ../docs-audience-map.svg
digraph docs_audience_map {
    graph [rankdir=TB, splines=spline, pad=0.35, nodesep=0.6, ranksep=0.5,
           bgcolor=white, fontname="Helvetica", fontsize=12, compound=true]
    node  [fontname="Helvetica", fontsize=11, style=filled, shape=box,
           fillcolor=white, color="#0077BB", penwidth=1.4]
    edge  [style=invis]

    human [shape=box, fillcolor="#EE7700", fontcolor=white, label=
        "Human decision\n\nshould-you-adopt.md\ndownstream-impact.md\nreview-and-release.md"]

    ai [shape=box, fillcolor="#99CCEE", label=
        "AI-operator instructions\n\nrun-agf-in-real-situations.md\nmcp-server.md\nsession-continuity.md (planned)"]

    concept [shape=box, fillcolor=white, color="#0077BB", label=
        "Shared concept\n\nroles-and-gates.md\ncoordination-protocol.md\nday-to-day.md"]

    reference [shape=box, fillcolor="#CCCCCC", label=
        "Reference\n\nenvironment-variables.md\nmaturity-vocabulary.md\ncontracts-and-validators.md"]

    {rank=same; human; ai}
    {rank=same; concept; reference}
    human -> concept
    ai -> reference
}
