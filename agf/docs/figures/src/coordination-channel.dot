// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: coordination channel and handoff resolution
// Generate: dot -Tsvg coordination-channel.dot -o ../coordination-channel.svg
digraph coord_channel {
    graph [rankdir=TB, splines=spline, pad=0.3, nodesep=0.5, ranksep=0.55,
           bgcolor=white, fontname="Helvetica", fontsize=12]
    node  [fontname="Helvetica", fontsize=11, style=filled, shape=box,
           fillcolor=white, color="#0077BB", penwidth=1.4]
    edge  [fontname="Helvetica", fontsize=10, color="#0077BB", penwidth=1.4]

    subgraph cluster_channel {
        label="docs/coordination/  (append-only)"
        style=filled
        fillcolor="#99CCEE"
        color="#0077BB"
        fontname="Helvetica"
        fontsize=12

        handoff   [label="handoff\n(requires-ack: true)", fillcolor=white]
        decision  [label="decision-record\n(gate decision)", fillcolor=white]
        completion [label="completion\n(task closed)", fillcolor="#009944",
                   fontcolor=white, color="#009944"]
        note      [label="note / review\n(advisory)", fillcolor=white,
                   color="#888888"]
    }

    agent_a  [label="Coder-Tester\n(implementation)", shape=ellipse,
              fillcolor="#99CCEE"]
    agent_b  [label="Governor-Reviewer\n(gate authority)", shape=ellipse,
              fillcolor="#99CCEE"]

    agent_a  -> handoff   [label="files"]
    handoff  -> agent_b   [label="directs\nattention"]
    agent_b  -> decision  [label="files"]
    decision -> agent_a   [label="authorizes\nor blocks"]
    agent_a  -> completion [label="files\n(after merge)"]
    agent_a  -> note      [label="files\n(advisory / status)"]
    agent_b  -> note      [label="files\n(advisory / status)"]

    legend [shape=plain, label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#888888" BGCOLOR="white">
            <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28"></TD><TD ALIGN="LEFT">participating agent (oval shape)</TD></TR>
            <TR><TD BORDER="1" COLOR="#0077BB" WIDTH="28"></TD><TD ALIGN="LEFT">coordination entry</TD></TR>
            <TR><TD BGCOLOR="#009944" WIDTH="28"></TD><TD ALIGN="LEFT">completed work</TD></TR>
            <TR><TD BORDER="1" COLOR="#888888" WIDTH="28"></TD><TD ALIGN="LEFT">advisory / status entry</TD></TR>
            <TR><TD><FONT COLOR="#0077BB">-----&gt;</FONT></TD><TD ALIGN="LEFT">authored entry / attention flow</TD></TR>
        </TABLE>
    >]
    {rank=same; legend; agent_a}
}
