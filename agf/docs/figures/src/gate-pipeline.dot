// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: Gate 1 / Gate 2 pipeline
// Generate: dot -Tsvg gate-pipeline.dot -o ../gate-pipeline.svg
digraph gate_pipeline {
    graph [rankdir=LR, splines=spline, pad=0.3, nodesep=0.4, ranksep=0.7,
           fontname="Helvetica", fontsize=11]
    node  [fontname="Helvetica", fontsize=10, style=filled, shape=box,
           fillcolor="#99CCEE", color="#0077BB", penwidth=1.2]
    edge  [fontname="Helvetica", fontsize=9, color="#0077BB", penwidth=1.2]

    idea     [label="Idea /\nRequest", shape=ellipse, fillcolor=white,
              color="#888888", fontcolor="#888888"]
    plan     [label="Plan file\n(plan/ branch)"]
    gate1    [label="Gate 1\nReview", shape=diamond, fillcolor="#99CCEE",
              color="#0077BB"]
    impl     [label="Implement\n(feat/ branch)"]
    gate2    [label="Gate 2\nReview", shape=diamond, fillcolor="#99CCEE",
              color="#0077BB"]
    merged   [label="Merged\nto main", fillcolor="#009944", fontcolor=white,
              color="#009944"]
    blocked  [label="Blocked /\nReturned", fillcolor="#CC3311", fontcolor=white,
              color="#CC3311", style="filled,dashed"]

    idea  -> plan
    plan  -> gate1  [label="handoff"]
    gate1 -> impl   [label="approved", color="#009944", fontcolor="#009944"]
    gate1 -> plan   [label="changes\nrequested", style=dashed, color="#EE7700",
                     fontcolor="#EE7700"]
    gate1 -> blocked [label="rejected", style=dashed, color="#CC3311",
                      fontcolor="#CC3311"]
    impl  -> gate2  [label="handoff"]
    gate2 -> merged [label="approved", color="#009944", fontcolor="#009944"]
    gate2 -> impl   [label="changes\nrequested", style=dashed, color="#EE7700",
                     fontcolor="#EE7700"]
    gate2 -> blocked [label="rejected", style=dashed, color="#CC3311",
                      fontcolor="#CC3311"]

    legend [shape=plain, label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="3" COLOR="#888888" BGCOLOR="white">
            <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
            <TR><TD BORDER="1" COLOR="#888888" WIDTH="28">oval</TD><TD ALIGN="LEFT">request / start state</TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28">diamond</TD><TD ALIGN="LEFT">human gate review</TD></TR>
            <TR><TD BGCOLOR="#99CCEE" WIDTH="28"></TD><TD ALIGN="LEFT">planned or implemented work</TD></TR>
            <TR><TD BGCOLOR="#009944" WIDTH="28"><FONT COLOR="white">box</FONT></TD><TD ALIGN="LEFT">approved / merged</TD></TR>
            <TR><TD><FONT COLOR="#EE7700">- - -&gt;</FONT></TD><TD ALIGN="LEFT">changes requested</TD></TR>
            <TR><TD><FONT COLOR="#CC3311">- - -&gt;</FONT></TD><TD ALIGN="LEFT">rejected / blocked</TD></TR>
        </TABLE>
    >]
    blocked -> legend [style=invis]
}
