// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: academic paper -- agent participation by governance phase
// Generate: dot -Tsvg agent-participation-by-phase.dot -o ../agent-participation-by-phase.svg
//           dot -Tpdf agent-participation-by-phase.dot -o ../agent-participation-by-phase.pdf
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section). This figure carries two
// independent axes, both real (not decorative): (1) phase nodes use the
// five-category responsibility palette (now including Shared concept
// for genuinely mixed-participation phases), shown in
// `cluster_shapekey`; (2) role nodes use a role-category colour axis
// (who the role is, not what kind of action a node represents), shown
// in `cluster_rolekey`, ellipses with real colour swatches. Edge line
// style (solid/dashed/dotted) is a third, independent axis -- evidence
// durability (whether the role has a distinct authored coordination
// record) -- documented by the three `legend*` notes.
//
// Gate 2 review 20260722T223540Z-contribution-auditor-r1gq (BLOCK 1,
// BLOCK 2) found this revision's first pass still conflated axes that
// should stay independent:
// - BLOCK 1: the role-category fill combined "tooling" with "active-
//   but-no-separate-record" evidence status into one category.
//   fact-checker is a mixed human+AI advisory role (same category as
//   contribution-auditor / academic-peer-reviewer) that happens to lack
//   a distinct authored record -- an evidence-status fact the edge
//   style already carries, not a different actor type. Only
//   infosec-sentinel is genuinely a tooling/CI role. Fixed: fact moved
//   to the mixed-role treatment; the grey role key renamed to describe
//   actor type only ("tooling / CI role"), with its dashed node border
//   removed (dashed is now edge-only, not doubled onto node fill).
// - BLOCK 2: `Advisory review` and `Academic paper review` were AI
//   action even though both phases show mixed human+AI+CI
//   participation in the diagram itself (auditor/fact/infosec feed
//   Advisory review; academic/governor/coder feed Academic paper
//   review). Fixed: both now use the Shared concept treatment.
digraph agent_participation_by_phase {
  graph [
    rankdir=LR,
    bgcolor=white,
    pad=0.28,
    nodesep=0.42,
    ranksep=0.62,
    splines=true,
    fontname="Helvetica",
    label="Agent participation by governance phase",
    labelloc=t,
    fontsize=18,
    fontcolor="#1A1A1A"
  ];

  node [
    fontname="Helvetica",
    fontsize=10.5,
    style=filled,
    shape=box,
    fillcolor="#99CCEE",
    color="#0077BB",
    fontcolor="#1A1A1A",
    penwidth=1.3,
    margin="0.10,0.07"
  ];

  edge [
    fontname="Helvetica",
    fontsize=8.5,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.65,
    penwidth=1.15
  ];

  subgraph cluster_shapekey {
    label = "Legend (phase responsibility / shape)"
    fontname = "Helvetica"
    fontsize = 10.5
    color = "#888888"
    margin = 8

    sk_diamond   [label="human decision\n(Gate 1 / Gate 2)", shape=diamond,
                  fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A",
                  fontsize=9]
    sk_ai        [label="AI action\n(setup / implement)",
                  style="filled,rounded", fillcolor="#99CCEE",
                  color="#0077BB", fontcolor="#1A1A1A", fontsize=9]
    sk_shared    [label="shared concept\n(mixed human + AI + CI)",
                  fillcolor=white, color="#0077BB", fontcolor="#0077BB",
                  fontsize=9]
    sk_automated [label="automated check\n(CI / tooling)",
                  style="filled,bold", peripheries=2, fillcolor="#009944",
                  color="#009944", fontcolor="#1A1A1A", fontsize=9]

    sk_diamond -> sk_ai -> sk_shared -> sk_automated [style=invis]
  }

  subgraph cluster_rolekey {
    label = "Legend (role category / fill)"
    fontname = "Helvetica"
    fontsize = 10.5
    color = "#888888"
    margin = 8

    rk_ai       [label="AI-primary role", shape=ellipse, fillcolor="#99CCEE",
                 color="#0077BB", fontcolor="#1A1A1A", fontsize=9]
    rk_human    [label="human-primary role", shape=ellipse,
                 fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A",
                 fontsize=9]
    rk_mixed    [label="mixed human + AI\nadvisory role", shape=ellipse,
                 fillcolor=white, color="#0077BB", fontcolor="#0077BB",
                 fontsize=9]
    rk_tooling  [label="tooling / CI role", shape=ellipse,
                 fillcolor="#CCCCCC", color="#888888", fontcolor="#1A1A1A",
                 fontsize=9]
    rk_alias    [label="pre-normalization\nalias / provenance", shape=ellipse,
                 style="filled,dotted", fillcolor=white, color="#888888",
                 fontcolor="#1A1A1A", fontsize=9]

    rk_ai -> rk_human -> rk_mixed -> rk_tooling -> rk_alias [style=invis]
  }

  subgraph cluster_agents {
    label="Roles";
    color="#888888";
    fontname="Helvetica";
    fontsize=12;
    fontcolor="#1A1A1A";
    style="rounded";

    planner  [label="planner-\narchitect", shape=ellipse, fillcolor="#99CCEE",
              color="#0077BB", fontcolor="#1A1A1A"];
    coder    [label="coder-\ntester", shape=ellipse, fillcolor="#99CCEE",
              color="#0077BB", fontcolor="#1A1A1A"];
    governor [label="governor-\nreviewer", shape=ellipse, fillcolor="#EE7700",
              color="#EE7700", fontcolor="#1A1A1A"];
    auditor  [label="contribution-\nauditor", shape=ellipse, fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"];
    academic [label="academic-peer-\nreviewer", shape=ellipse, fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"];
    fact     [label="fact-\nchecker", shape=ellipse, fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"];
    infosec  [label="infosec-\nsentinel", shape=ellipse,
              fillcolor="#CCCCCC", color="#888888", fontcolor="#1A1A1A"];
    alias    [label="pre-normalized\nclaude / human", shape=ellipse,
              style="filled,dotted", fillcolor=white, color="#888888",
              fontcolor="#1A1A1A"];
  }

  subgraph cluster_phases {
    label="Governance phases";
    color="#888888";
    fontname="Helvetica";
    fontsize=12;
    fontcolor="#1A1A1A";
    style="rounded";

    bootstrap      [label="Bootstrap\nsetup", style="filled,rounded",
                    fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"];
    gate1          [label="Gate 1\nplanning", shape=diamond,
                    fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"];
    advisory       [label="Advisory\nreview", fillcolor=white,
                    color="#0077BB", fontcolor="#0077BB"];
    implementation [label="Implementation\nand validation", style="filled,rounded",
                    fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"];
    gate2          [label="Gate 2\ndecision", shape=diamond,
                    fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"];
    academic_phase [label="Academic\npaper review", fillcolor=white,
                    color="#0077BB", fontcolor="#0077BB"];
    ci             [label="CI / tooling\nchecks", style="filled,bold",
                    peripheries=2, fillcolor="#009944", color="#009944",
                    fontcolor="#1A1A1A"];
  }

  alias -> bootstrap [label="early records", style=dotted, color="#888888", fontcolor="#1A1A1A"];

  planner -> bootstrap [label="setup"];
  planner -> gate1 [label="plans"];
  planner -> advisory [label="routes"];

  auditor -> advisory [label="audits"];
  fact -> advisory [label="active; no\nseparate post", style=dashed, color="#888888"];
  infosec -> advisory [label="required\nconsultation", style=dashed, color="#888888"];

  coder -> implementation [label="implements"];
  coder -> ci [label="runs local\nvalidators"];
  infosec -> ci [label="tooling role", style=dashed, color="#888888"];

  governor -> gate1 [label="approves", color="#EE7700"];
  governor -> gate2 [label="decides", color="#EE7700"];
  governor -> advisory [label="activates\nroles", color="#EE7700"];

  academic -> academic_phase [label="review"];
  governor -> academic_phase [label="requested /\nreceived", color="#EE7700"];
  coder -> academic_phase [label="revised\npaper"];

  gate1 -> implementation [label="approved", color="#009944"];
  implementation -> gate2 [label="handoff"];
  advisory -> gate1 [label="findings", style=dashed, color="#888888"];
  academic_phase -> implementation [label="revision\nrequests", style=dashed, color="#888888"];

  legend1 [label="solid = durable authored\ncoordination/review evidence", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];
  legend2 [label="dashed = active or required role\nwithout separate authored record", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];
  legend3 [label="dotted = pre-normalization\nalias/provenance evidence", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];

  legend1 -> legend2 [style=invis];
  legend2 -> legend3 [style=invis];
}
