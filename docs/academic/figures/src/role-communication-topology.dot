// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: academic paper -- role communication topology
// Generate: dot -Tsvg role-communication-topology.dot -o ../role-communication-topology.svg
//           dot -Tpdf role-communication-topology.dot -o ../role-communication-topology.pdf
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section). This figure uses the
// role-category colour axis established in coordination-channel.dot
// (Class 1) and agent-participation-by-phase.dot (this class): role
// nodes are ellipses coloured by role category (human-primary,
// AI-primary, mixed advisory, tooling/dashed), not by the five-category
// event/action shapes -- there are no phase/event nodes in this figure,
// only role nodes and communication edges, so only the role-key legend
// applies here. Edge line style (solid/dashed) is a separate,
// pre-existing and accurate axis documented by `legend_solid`/
// `legend_dash`. Previously this figure had a legend for edge style and
// the human-authority accent colour only; the general node fill-colour
// meaning was undocumented and used an unrelated slate/teal/rust/gold
// palette -- both defects this revision fixes. The former "gold" accent
// is now `amber` (`#EE7700`), the palette's Human decision token,
// matching the caption wording update in the paper.
//
// The role-key swatches (rk_*) live in the same legend column as the
// pre-existing edge-style notes (legend_solid/legend_dash/legend_human),
// chained by the same `rank=same` + sequential invisible-edge technique
// those notes already used -- not a separate `cluster_rolekey` subgraph.
// An earlier draft wrapped the swatches in their own cluster with an
// internal invisible-edge chain plus a cross-cluster invisible edge into
// the diagram; in this LR-flow figure that created a second, competing
// rank system and visibly broke the layout (legend notes scattered with
// large gaps, confirmed via `dot -Tpng` visual inspection per
// visible-artifact-verification-rule). Reusing the one proven column
// avoids that failure mode.
digraph role_communication_topology {
  graph [
    rankdir=LR,
    bgcolor=white,
    pad=0.25,
    nodesep=0.45,
    ranksep=0.62,
    splines=true,
    fontname="Helvetica",
    label="Role communication topology",
    labelloc=t,
    fontsize=18,
    fontcolor="#1A1A1A"
  ];

  node [
    fontname="Helvetica",
    fontsize=10.5,
    style=filled,
    shape=ellipse,
    fillcolor="#99CCEE",
    color="#0077BB",
    fontcolor="#1A1A1A",
    penwidth=1.3,
    margin="0.10,0.07"
  ];

  edge [
    fontname="Helvetica",
    fontsize=8.5,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.65,
    penwidth=1.15
  ];

  rk_human   [label="human-primary role", fillcolor="#EE7700",
              color="#EE7700", fontcolor="#1A1A1A", fontsize=9]
  rk_ai      [label="AI-primary role", fillcolor="#99CCEE",
              color="#0077BB", fontcolor="#1A1A1A", fontsize=9]
  rk_mixed   [label="mixed human + AI\nadvisory role", fillcolor=white,
              color="#0077BB", fontcolor="#0077BB", fontsize=9]
  rk_tooling [label="tooling / active-but-\nno-separate-record role",
              style="filled,dashed", fillcolor="#CCCCCC", color="#888888",
              fontcolor="#1A1A1A", fontsize=9]

  human    [label="human\nJani", fillcolor="#EE7700", color="#EE7700",
            fontcolor="#1A1A1A"];
  governor [label="governor-\nreviewer", fillcolor="#EE7700", color="#EE7700",
            fontcolor="#1A1A1A", penwidth=1.8];
  planner  [label="planner-\narchitect", fillcolor="#99CCEE", color="#0077BB",
            fontcolor="#1A1A1A"];
  coder    [label="coder-\ntester", fillcolor="#99CCEE", color="#0077BB",
            fontcolor="#1A1A1A"];
  auditor  [label="contribution-\nauditor", fillcolor=white, color="#0077BB",
            fontcolor="#0077BB"];
  academic [label="academic-peer-\nreviewer", fillcolor=white, color="#0077BB",
            fontcolor="#0077BB"];
  fact     [label="fact-\nchecker", style="filled,dashed", fillcolor="#CCCCCC",
            color="#888888", fontcolor="#1A1A1A"];
  infosec  [label="infosec-\nsentinel", style="filled,dashed", fillcolor="#CCCCCC",
            color="#888888", fontcolor="#1A1A1A"];

  human -> governor [label="decisions /\napprovals", dir=both,
                     color="#EE7700", fontcolor="#1A1A1A", penwidth=1.35];

  governor -> planner [label="Gate 1 /\nrework", dir=both];
  governor -> coder [label="Gate 2 /\nimplementation", dir=both];
  planner -> coder [label="plans /\nquestions", dir=both];

  auditor -> governor [label="audit\nfindings"];
  academic -> governor [label="peer review\nfindings"];

  governor -> fact [label="factual\nreview", dir=both, style=dashed, color="#888888"];
  governor -> infosec [label="security /\nlearning checks", dir=both, style=dashed, color="#888888"];
  infosec -> coder [label="validator\nfindings", style=dashed, color="#888888"];

  legend_solid [label="solid = observed durable\ncoordination/review traffic", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];
  legend_dash [label="dashed = active or required\ndeclared channel", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];
  legend_human [label="amber = human final\nauthority path", shape=note, fillcolor="white", color="#888888", fontcolor="#1A1A1A", fontsize=9];

  { rank=same; human; governor; }
  { rank=same; planner; coder; }
  { rank=same; auditor; academic; fact; infosec; }
  { rank=same; legend_solid; legend_dash; legend_human;
    rk_human; rk_ai; rk_mixed; rk_tooling; }

  legend_solid -> legend_dash -> legend_human
      -> rk_human -> rk_ai -> rk_mixed -> rk_tooling [style=invis];
}
