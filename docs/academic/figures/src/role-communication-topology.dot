digraph role_communication_topology {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad=0.22,
    nodesep=0.45,
    ranksep=0.62,
    splines=true,
    fontname="Helvetica",
    label="Role communication topology",
    labelloc=t,
    fontsize=18,
    fontcolor="#1F2933"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10.5,
    color="#536471",
    penwidth=1.3,
    fillcolor="#EEF2F4",
    fontcolor="#1F2933",
    margin="0.10,0.07"
  ];

  edge [
    fontname="Helvetica",
    fontsize=8.5,
    color="#536471",
    fontcolor="#536471",
    arrowsize=0.65,
    penwidth=1.15
  ];

  human [label="human\nJani", fillcolor="#FFF5DE", color="#C89B3C"];
  governor [label="governor-\nreviewer", fillcolor="#FFF5DE", color="#C89B3C", penwidth=1.8];
  planner [label="planner-\narchitect", fillcolor="#E7F3F3", color="#2A7F7F"];
  coder [label="coder-\ntester", fillcolor="#E7F3F3", color="#2A7F7F"];
  auditor [label="contribution-\nauditor", fillcolor="#F6ECE6", color="#B66A3C"];
  academic [label="academic-peer-\nreviewer", fillcolor="#F6ECE6", color="#B66A3C"];
  fact [label="fact-\nchecker", fillcolor="#EEF2F4", color="#536471", style="rounded,dashed,filled"];
  infosec [label="infosec-\nsentinel", fillcolor="#EEF2F4", color="#536471", style="rounded,dashed,filled"];

  human -> governor [label="decisions /\napprovals", dir=both, color="#C89B3C", fontcolor="#9A6A12", penwidth=1.35];

  governor -> planner [label="Gate 1 /\nrework", dir=both];
  governor -> coder [label="Gate 2 /\nimplementation", dir=both];
  planner -> coder [label="plans /\nquestions", dir=both];

  auditor -> governor [label="audit\nfindings"];
  academic -> governor [label="peer review\nfindings"];

  governor -> fact [label="factual\nreview", dir=both, style=dashed];
  governor -> infosec [label="security /\nlearning checks", dir=both, style=dashed];
  infosec -> coder [label="validator\nfindings", style=dashed];

  legend_solid [label="solid = observed durable\ncoordination/review traffic", shape=note, fillcolor="#FFFFFF", color="#9AA6AF", fontsize=9];
  legend_dash [label="dashed = active or required\ndeclared channel", shape=note, fillcolor="#FFFFFF", color="#9AA6AF", fontsize=9];
  legend_human [label="gold = human final\nauthority path", shape=note, fillcolor="#FFFFFF", color="#9AA6AF", fontsize=9];

  { rank=same; human; governor; }
  { rank=same; planner; coder; }
  { rank=same; auditor; academic; fact; infosec; }
  { rank=same; legend_solid; legend_dash; legend_human; }

  legend_solid -> legend_dash [style=invis];
  legend_dash -> legend_human [style=invis];
}
