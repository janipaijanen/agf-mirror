// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: academic paper -- Gate 1 / Gate 2 workflow
// Generate: dot -Tsvg gate-workflow.dot -o ../gate-workflow.svg
//           dot -Tpdf gate-workflow.dot -o ../gate-workflow.pdf
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section) -- the same contract and
// shape-key convention used by the site's Class 1 DOT figures
// (gate-pipeline.dot, governance-loop.dot). This figure previously had
// no legend at all (0 legend lines) and used an unrelated slate/teal/
// rust palette family shared only with the other 4 academic figures --
// both defects this revision fixes. `red-mid` remains the separate
// rejected/blocked outcome accent, not a sixth responsibility category.
digraph gate_workflow {
  graph [
    rankdir=LR,
    bgcolor=white,
    pad=0.25,
    nodesep=0.48,
    ranksep=0.65,
    fontname="Helvetica",
    label="Gate 1 / Gate 2 workflow",
    labelloc=t,
    fontsize=18,
    fontcolor="#1A1A1A"
  ];

  node [
    fontname="Helvetica",
    fontsize=10.5,
    style=filled,
    shape=box,
    fillcolor="#99CCEE",
    color="#0077BB",
    fontcolor="#1A1A1A",
    penwidth=1.3,
    margin="0.10,0.07"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.72,
    penwidth=1.25
  ];

  // Shape key: real shapes, self-labeled -- same convention as
  // gate-pipeline.dot's shape key.
  subgraph cluster_shapekey {
    label = "Legend (responsibility / shape)"
    fontname = "Helvetica"
    fontsize = 11
    color = "#888888"
    margin = 10

    sk_oval      [label="idea / start", shape=ellipse, fillcolor=white,
                  color="#888888", fontcolor="#1A1A1A"]
    sk_diamond   [label="human decision\n(Gate review)", shape=diamond,
                  fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"]
    sk_ai        [label="AI action\n(plan / advise / implement)",
                  style="filled,rounded", fillcolor="#99CCEE",
                  color="#0077BB", fontcolor="#1A1A1A"]
    sk_automated [label="automated check /\nvalidated outcome",
                  style="filled,bold", peripheries=2, fillcolor="#009944",
                  color="#009944", fontcolor="#1A1A1A"]
    sk_rejected  [label="rejected /\nblocked outcome",
                  style="filled,dashed", fillcolor="#CC3311",
                  color="#CC3311", fontcolor=white]

    sk_oval -> sk_diamond -> sk_ai -> sk_automated -> sk_rejected
        [style=invis]
  }

  idea      [label="Change\nidea", shape=ellipse, fillcolor=white,
             color="#888888", fontcolor="#1A1A1A"]
  plan      [label="Gate 1\nplan", style="filled,rounded",
             fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"]
  advisory  [label="Advisory\nconsultation", style="filled,rounded",
             fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"]
  decision1 [label="Governor\nGate 1 decision", shape=diamond,
             fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"]
  branch    [label="Scoped\nfeature branch", style="filled,rounded",
             fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"]
  validate  [label="Tests and\nvalidators", style="filled,bold",
             peripheries=2, fillcolor="#009944", color="#009944",
             fontcolor="#1A1A1A"]
  review    [label="Gate 2\nreview", shape=diamond, fillcolor="#EE7700",
             color="#EE7700", fontcolor="#1A1A1A"]
  merge     [label="Merge to\nmaster", style="filled,bold", peripheries=2,
             fillcolor="#009944", color="#009944", fontcolor="#1A1A1A"]
  rework    [label="Reject or\nrework", style="filled,dashed",
             fillcolor="#CC3311", color="#CC3311", fontcolor=white]

  sk_rejected -> idea [style=invis]

  idea -> plan;
  plan -> advisory;
  advisory -> decision1;
  decision1 -> branch [label="approved", color="#009944"];
  decision1 -> rework [label="not approved", style=dashed,
                       color="#CC3311", fontcolor="#CC3311",
                       constraint=false];
  branch -> validate;
  validate -> review;
  review -> merge [label="approved", color="#009944"];
  review -> rework [label="changes needed", style=dashed,
                    color="#CC3311", fontcolor="#CC3311", constraint=false];
  rework -> plan [label="revise", style=dashed, color="#888888",
                  fontcolor="#1A1A1A"];

  { rank=same; decision1; rework }
}
