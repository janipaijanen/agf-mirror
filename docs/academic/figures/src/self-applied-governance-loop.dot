digraph self_applied_governance_loop {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad=0.25,
    nodesep=0.55,
    ranksep=0.7,
    fontname="Helvetica",
    label="Self-applied governance loop",
    labelloc=t,
    fontsize=18,
    fontcolor="#1F2933"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=11,
    color="#536471",
    penwidth=1.4,
    fillcolor="#EEF2F4",
    fontcolor="#1F2933",
    margin="0.11,0.08"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#536471",
    fontcolor="#536471",
    arrowsize=0.75,
    penwidth=1.3
  ];

  agents [label="Human and AI\nagent roles", fillcolor="#E7F3F3", color="#2A7F7F"];
  plans [label="Gate 1\nplans"];
  records [label="Append-only\ncoordination records", fillcolor="#FFF5DE", color="#C89B3C"];
  validators [label="Schemas and\nvalidators", fillcolor="#F6ECE6", color="#B66A3C"];
  decisions [label="Gate decisions\nand merges"];
  learnings [label="Learning\nrecords", fillcolor="#FFF5DE", color="#C89B3C"];
  rules [label="Rules, docs,\nand CI checks", fillcolor="#F6ECE6", color="#B66A3C"];
  product [label="Foundry\nframework", fillcolor="#E7F3F3", color="#2A7F7F"];

  agents -> plans [label="propose"];
  plans -> records [label="record"];
  records -> validators [label="check"];
  validators -> decisions [label="inform"];
  decisions -> product [label="change"];
  product -> agents [label="governs"];
  records -> learnings [label="friction"];
  learnings -> rules [label="promote"];
  rules -> validators [label="encode"];
}
