// SPDX-License-Identifier: CC-BY-SA-4.0
// agents-govern: academic paper -- self-applied governance loop
// Generate: dot -Tsvg self-applied-governance-loop.dot -o ../self-applied-governance-loop.svg
//           dot -Tpdf self-applied-governance-loop.dot -o ../self-applied-governance-loop.pdf
//
// Semantic responsibility palette: agf/docs/site/reference/palette.md
// ("Semantic responsibility palette" section) -- same contract and
// shape-key convention as the other Workstream D figures. This figure
// previously had no legend at all and used an unrelated slate/teal/rust
// palette family -- both defects this revision fixes. "Human and AI
// agent roles" and "Foundry framework" are the figure's two genuinely
// mixed-responsibility nodes (an actor set and a shared artifact, not a
// single-actor action) and map to Shared concept.
//
// Gate 2 review 20260722T223540Z-contribution-auditor-r1gq (BLOCK 2)
// found three further nodes claiming the wrong actor class:
// - "Append-only coordination records" was Automated check/validated
//   outcome, but the very next edge in the diagram (records ->
//   validators, "check") shows it has not been validated yet at that
//   point -- an authored-but-unchecked record is not already a
//   validated outcome. Fixed: Shared concept.
// - "Rules, docs, and CI checks" combined an authored artifact (rule,
//   doc) with an automated mechanism (CI check) but was rendered as a
//   single AI action. Fixed: Shared concept, so the composite does not
//   claim one actor class.
// - "Learning records" was Automated check/validated outcome, but
//   (like "records" above) the diagram shows no validation step before
//   it -- friction flows into it directly. Fixed: Shared concept.
// "Schemas and validators" keeps the Automated check treatment; it is
// the actual automated-check step both other nodes flow into.
digraph self_applied_governance_loop {
  graph [
    rankdir=LR,
    bgcolor=white,
    pad=0.28,
    nodesep=0.55,
    ranksep=0.7,
    fontname="Helvetica",
    label="Self-applied governance loop",
    labelloc=t,
    fontsize=18,
    fontcolor="#1A1A1A"
  ];

  node [
    fontname="Helvetica",
    fontsize=11,
    style=filled,
    shape=box,
    fillcolor="#99CCEE",
    color="#0077BB",
    fontcolor="#1A1A1A",
    penwidth=1.4,
    margin="0.11,0.08"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#0077BB",
    fontcolor="#1A1A1A",
    arrowsize=0.75,
    penwidth=1.3
  ];

  subgraph cluster_shapekey {
    label = "Legend (responsibility / shape)"
    fontname = "Helvetica"
    fontsize = 11
    color = "#888888"
    margin = 10

    sk_shared    [label="shared concept\n(mixed human + AI)",
                  fillcolor=white, color="#0077BB", fontcolor="#0077BB"]
    sk_diamond   [label="human decision\n(gate / merge)", shape=diamond,
                  fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"]
    sk_ai        [label="AI action\n(plan / propose)",
                  style="filled,rounded", fillcolor="#99CCEE",
                  color="#0077BB", fontcolor="#1A1A1A"]
    sk_automated [label="automated check /\nvalidated outcome",
                  style="filled,bold", peripheries=2, fillcolor="#009944",
                  color="#009944", fontcolor="#1A1A1A"]

    sk_shared -> sk_diamond -> sk_ai -> sk_automated [style=invis]
  }

  agents     [label="Human and AI\nagent roles", fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"]
  plans      [label="Gate 1\nplans", style="filled,rounded",
              fillcolor="#99CCEE", color="#0077BB", fontcolor="#1A1A1A"]
  records    [label="Append-only\ncoordination records", fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"]
  validators [label="Schemas and\nvalidators", style="filled,bold",
              peripheries=2, fillcolor="#009944", color="#009944",
              fontcolor="#1A1A1A"]
  decisions  [label="Gate decisions\nand merges", shape=diamond,
              fillcolor="#EE7700", color="#EE7700", fontcolor="#1A1A1A"]
  learnings  [label="Learning\nrecords", fillcolor=white, color="#0077BB",
              fontcolor="#0077BB"]
  rules      [label="Rules, docs,\nand CI checks", fillcolor=white,
              color="#0077BB", fontcolor="#0077BB"]
  product    [label="Foundry\nframework", fillcolor=white, color="#0077BB",
              fontcolor="#0077BB"]

  sk_automated -> agents [style=invis]

  agents -> plans [label="propose"];
  plans -> records [label="record"];
  records -> validators [label="check"];
  validators -> decisions [label="inform"];
  decisions -> product [label="change", color="#009944"];
  product -> agents [label="governs"];
  records -> learnings [label="friction"];
  learnings -> rules [label="promote"];
  rules -> validators [label="encode"];
}
