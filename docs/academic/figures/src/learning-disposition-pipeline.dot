digraph learning_disposition_pipeline {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    pad=0.22,
    nodesep=0.48,
    ranksep=0.65,
    fontname="Helvetica",
    label="Learning disposition pipeline",
    labelloc=t,
    fontsize=18,
    fontcolor="#1F2933"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10.5,
    color="#536471",
    penwidth=1.3,
    fillcolor="#EEF2F4",
    fontcolor="#1F2933",
    margin="0.10,0.07"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#536471",
    fontcolor="#536471",
    arrowsize=0.72,
    penwidth=1.25
  ];

  friction [label="Operational\nfriction"];
  review [label="Learning\nreview"];
  disposition [label="Disposition\nchoice", shape=diamond, margin="0.05,0.04", fillcolor="#FFF5DE", color="#C89B3C"];
  no_action [label="No action", fillcolor="#EEF2F4"];
  docs [label="Docs or\nexamples", fillcolor="#E7F3F3", color="#2A7F7F"];
  learning [label="Learning\nrecord", fillcolor="#FFF5DE", color="#C89B3C"];
  rule [label="Rule or schema\nproposal", fillcolor="#F6ECE6", color="#B66A3C"];
  warn [label="Warn-only\nvalidator"];
  block [label="Blocking\nCI check", fillcolor="#FDECEC", color="#B42318"];

  friction -> review;
  review -> disposition;
  disposition -> no_action [label="not reusable"];
  disposition -> docs [label="explain"];
  disposition -> learning [label="capture"];
  learning -> rule [label="promote"];
  rule -> warn [label="soft enforce"];
  warn -> block [label="deterministic"];
  block -> friction [label="new evidence", style=dashed];
}
