#!/usr/bin/env sh
set -eu

script_path=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$0" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    script_path=$resolved
  fi
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
rust_debug="$repo_root/tooling/rust/target/debug/agov"
rust_release="$repo_root/tooling/rust/target/release/agov"

export AGOV_SCHEMA_DIR="${AGOV_SCHEMA_DIR:-$repo_root/agf/schemas}"
export AGOV_MANIFEST_PATH="${AGOV_MANIFEST_PATH:-$repo_root/agf/agents/MANIFEST.yaml}"

rust_supported() {
  case "${1:-}" in
    -V|--version|version)
      return 0
      ;;
    coord)
      case "${2:-}" in
        -h|--help|help) return 0 ;;
        validate|brief|post|list|status|stale) return 0 ;;
        visibility) return 0 ;;
        graph|graph-index) return 0 ;;
      esac
      ;;
    plan)
      case "${2:-}" in
        validate) return 0 ;;
      esac
      ;;
    validate)
      return 0
      ;;
    handoff)
      case "${2:-}" in
        next|take|complete) return 0 ;;
      esac
      ;;
    session)
      case "${2:-}" in
        resume) return 0 ;;
      esac
      ;;
    token)
      case "${2:-}:${3:-}" in
        roi:report) return 0 ;;
      esac
      ;;
    dist)
      case "${2:-}" in
        validate|build|check-tag) return 0 ;;
      esac
      ;;
    usage)
      case "${2:-}" in
        report) return 0 ;;
      esac
      ;;
    agov.coord.validate|agov.plan.validate|agov.session.resume|agov.token.roi|agov.usage.report)
      return 0
      ;;
  esac

  return 1
}

run_rust() {
  if [ -x "$rust_release" ]; then
    exec "$rust_release" "$@"
  fi

  if [ -x "$rust_debug" ]; then
    exec "$rust_debug" "$@"
  fi

  if command -v cargo >/dev/null 2>&1; then
    exec cargo run --quiet --manifest-path "$repo_root/tooling/rust/Cargo.toml" -p agov -- "$@"
  fi

  return 127
}

case "${1:-}" in
  -h|--help)
    cat <<EOF
Usage:
  agov --version
  agov version [--format text|json]
  agov coord validate <file>...
  agov coord brief [--id-format ulid|readable] [--from <role>] [--to <role>] [--kind <kind>] [--topic <topic>]
  agov coord post --from <role> --to <role> --kind <kind> --topic <topic> [--ref <message>]
  agov coord list [--since <message-id-or-timestamp>] [--format text|json]
  agov coord status [--dir <coord-dir>] [--recent <n>] [--roles]
  agov coord stale [--dir <coord-dir>]
  agov coord visibility [--base-branch <branch>] [--branch <branch>] [--format text|json]
  agov coord graph [--dir <coord-dir>] [--format dot|text]
  agov coord graph-index [--dir <coord-dir>] [--output <file>]
  agov plan validate <file>...
  agov agov.coord.validate <file>...
  agov agov.plan.validate <file>...
  agov validate [adoption|agents|learnings|infosec|contributions|framework-config]
  agov handoff next <agent-role> [--dir <coord-dir>]
  agov handoff take <handoff-id> --from <role> [--dir <coord-dir>]
  agov handoff complete <handoff-id> --from <role> [--to <role>] [--dir <coord-dir>]
  agov session resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov agov.session.resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov token roi report [--log <path>]
  agov agov.token.roi report [--log <path>]
  agov dist validate
  agov dist build
  agov dist check-tag
  agov usage report [--dir <coord-dir>] [--manifest <path>] [--last <n>]
  agov agov.usage.report [--dir <coord-dir>] [--manifest <path>] [--last <n>]

Rust implementation is the supported operator path. If a command is missing
from Rust, stop and report the tooling gap instead of falling back to legacy
tooling.

Build local Rust executable:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov

Use release builds for normal agent/operator work. Use debug builds only when
actively debugging Rust internals:
  cargo build --manifest-path tooling/rust/Cargo.toml -p agov
EOF
    exit 0
    ;;
esac

if rust_supported "$@"; then
  run_rust "$@"
fi

cat >&2 <<EOF
agov: command not available in local Rust tooling.

If this is a supported command, build the Rust executable first:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov
  export PATH="\$PWD/tooling:\$PATH"

If the command is not yet implemented in Rust, stop and report the gap.
Do not use legacy tooling for routine agent or operator work.

Supported Rust commands:
  agov --version
  agov version [--format text|json]
  agov coord validate <file>...
  agov coord brief [--id-format ulid|readable] [--from <role>]
  agov coord post --from <role> --to <role> --kind <kind> --topic <topic>
  agov coord list [--since <message-id-or-timestamp>] [--format text|json]
  agov coord status [--dir <coord-dir>]
  agov coord stale [--dir <coord-dir>]
  agov coord visibility [--base-branch <branch>]
  agov coord graph [--dir <coord-dir>] [--format dot|text]
  agov coord graph-index [--dir <coord-dir>] [--output <file>]
  agov plan validate <file>...
  agov handoff next <agent-role> [--dir <coord-dir>]
  agov handoff take <handoff-id> --from <role> [--dir <coord-dir>]
  agov handoff complete <handoff-id> --from <role> [--to <role>] [--dir <coord-dir>]
  agov session resume [--role <agent-role>] [--base-branch <branch>]
  agov token roi report [--log <path>]
  agov usage report [--dir <coord-dir>] [--manifest <path>]
EOF
exit 127
