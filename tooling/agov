#!/usr/bin/env sh
set -eu

script_path=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$0" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    script_path=$resolved
  fi
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
rust_debug="$repo_root/tooling/rust/target/debug/agov"
rust_release="$repo_root/tooling/rust/target/release/agov"
freshness_paths="tooling/agov tooling/rust agf/schemas agf/agents/MANIFEST.yaml"

export AGOV_SCHEMA_DIR="${AGOV_SCHEMA_DIR:-$repo_root/agf/schemas}"
export AGOV_MANIFEST_PATH="${AGOV_MANIFEST_PATH:-$repo_root/agf/agents/MANIFEST.yaml}"

rust_supported() {
  case "${1:-}" in
    -V|--version|version)
      return 0
      ;;
    coord)
      case "${2:-}" in
        -h|--help|help) return 0 ;;
        validate|brief|post|list|status|stale) return 0 ;;
        visibility) return 0 ;;
        graph|graph-index) return 0 ;;
      esac
      ;;
    plan)
      case "${2:-}" in
        validate) return 0 ;;
      esac
      ;;
    validate)
      return 0
      ;;
    handoff)
      case "${2:-}" in
        next|take|complete) return 0 ;;
      esac
      ;;
    session)
      case "${2:-}" in
        resume) return 0 ;;
      esac
      ;;
    token)
      case "${2:-}:${3:-}" in
        roi:report) return 0 ;;
      esac
      ;;
    dist)
      case "${2:-}" in
        validate|build|check-tag) return 0 ;;
      esac
      ;;
    usage)
      case "${2:-}" in
        report) return 0 ;;
      esac
      ;;
    agov.coord.validate|agov.plan.validate|agov.session.resume|agov.token.roi|agov.usage.report)
      return 0
      ;;
  esac

  return 1
}

run_rust() {
  if [ "${AGOV_ALLOW_STALE_LOCAL_BINARY:-0}" = "1" ]; then
    if [ "${CI:-}" = "true" ]; then
      echo "agov: AGOV_ALLOW_STALE_LOCAL_BINARY is forbidden in CI" >&2
      return 126
    fi
    echo "WARN agov freshness gate explicitly bypassed for local development" >&2
    if [ -x "$rust_release" ]; then
      exec "$rust_release" "$@"
    fi
    if [ -x "$rust_debug" ]; then
      exec "$rust_debug" "$@"
    fi
  fi

  base_ref=$(requested_base_ref "$@")
  if [ -x "$rust_release" ] && binary_is_fresh "$rust_release" "$base_ref"; then
    exec "$rust_release" "$@"
  fi

  if [ -x "$rust_debug" ] && binary_is_fresh "$rust_debug" "$base_ref"; then
    exec "$rust_debug" "$@"
  fi

  cat >&2 <<EOF
agov: no provenance-compatible local binary is available.
Rebuild from the intended checkout, then retry:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov
EOF
  return 127
}

requested_base_ref() {
  if [ "${1:-}" != "session" ] || [ "${2:-}" != "resume" ]; then
    return 0
  fi
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base-branch)
        [ "$#" -ge 2 ] && printf '%s\n' "$2"
        return 0
        ;;
      --base-branch=*)
        printf '%s\n' "${1#--base-branch=}"
        return 0
        ;;
    esac
    shift
  done
}

json_string() {
  key=$1
  value=$2
  printf '%s\n' "$value" | sed -n "s/.*\"$key\":\"\([^\"]*\)\".*/\1/p"
}

json_bool() {
  key=$1
  value=$2
  printf '%s\n' "$value" | sed -n "s/.*\"$key\":\(true\|false\).*/\1/p"
}

binary_is_fresh() {
  binary=$1
  base_ref=$2
  provenance=$($binary version --format json 2>/dev/null || true)
  commit=$(json_string commit "$provenance")
  source_dirty=$(json_bool source_dirty "$provenance")

  case "$commit" in
    ''|*[!0-9a-fA-F]*)
      echo "WARN rejected $binary: missing or malformed full commit provenance" >&2
      return 1
      ;;
  esac
  if [ "${#commit}" -ne 40 ]; then
    echo "WARN rejected $binary: missing or malformed full commit provenance" >&2
    return 1
  fi
  if [ "$source_dirty" != "false" ]; then
    echo "WARN rejected $binary: build-relevant tracked sources were dirty" >&2
    return 1
  fi
  if ! git -C "$repo_root" cat-file -e "$commit^{commit}" 2>/dev/null; then
    echo "WARN rejected $binary: embedded commit $commit is unavailable locally" >&2
    return 1
  fi
  if ! worktree_matches_binary "$commit" HEAD; then
    echo "WARN rejected $binary: stale relative to worktree HEAD" >&2
    return 1
  fi
  if [ -n "$base_ref" ] && ! base_matches_binary "$commit" "$base_ref"; then
    echo "WARN rejected $binary: stale relative to requested base $base_ref" >&2
    return 1
  fi
  if ! git -C "$repo_root" diff --quiet -- $freshness_paths \
    || ! git -C "$repo_root" diff --cached --quiet -- $freshness_paths; then
    echo "WARN rejected $binary: tracked freshness-sensitive files are modified" >&2
    return 1
  fi
  return 0
}

worktree_matches_binary() {
  commit=$1
  target_ref=$2
  if ! target=$(git -C "$repo_root" rev-parse --verify "$target_ref^{commit}" 2>/dev/null); then
    echo "WARN cannot resolve freshness target $target_ref" >&2
    return 1
  fi
  git -C "$repo_root" merge-base --is-ancestor "$commit" "$target" 2>/dev/null \
    && git -C "$repo_root" diff --quiet "$commit" "$target" -- $freshness_paths
}

base_matches_binary() {
  commit=$1
  base_ref=$2
  if ! base=$(git -C "$repo_root" rev-parse --verify "$base_ref^{commit}" 2>/dev/null); then
    echo "WARN cannot resolve freshness target $base_ref" >&2
    return 1
  fi
  if git -C "$repo_root" merge-base --is-ancestor "$base" "$commit" 2>/dev/null; then
    return 0
  fi
  git -C "$repo_root" merge-base --is-ancestor "$commit" "$base" 2>/dev/null \
    && git -C "$repo_root" diff --quiet "$commit" "$base" -- $freshness_paths
}

case "${1:-}" in
  -h|--help)
    cat <<EOF
Usage:
  agov --version
  agov version [--format text|json]
  agov coord validate <file>...
  agov coord brief [--id-format ulid|readable] [--from <role>] [--to <role>] [--kind <kind>] [--topic <topic>]
  agov coord post --from <role> --to <role> --kind <kind> --topic <topic> [--ref <message>]
  agov coord list [--since <message-id-or-timestamp>] [--format text|json]
  agov coord status [--dir <coord-dir>] [--recent <n>] [--roles]
  agov coord stale [--dir <coord-dir>]
  agov coord visibility [--base-branch <branch>] [--branch <branch>] [--format text|json]
  agov coord graph [--dir <coord-dir>] [--format dot|text]
  agov coord graph-index [--dir <coord-dir>] [--output <file>]
  agov plan validate <file>...
  agov agov.coord.validate <file>...
  agov agov.plan.validate <file>...
  agov validate [adoption|agents|learnings|infosec|contributions|framework-config]
  agov handoff next <agent-role> [--dir <coord-dir>]
  agov handoff take <handoff-id> --from <role> [--dir <coord-dir>]
  agov handoff complete <handoff-id> --from <role> [--to <role>] [--dir <coord-dir>]
  agov session resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov agov.session.resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov token roi report [--log <path>]
  agov agov.token.roi report [--log <path>]
  agov dist validate
  agov dist build
  agov dist check-tag
  agov usage report [--dir <coord-dir>] [--manifest <path>] [--last <n>]
  agov agov.usage.report [--dir <coord-dir>] [--manifest <path>] [--last <n>]

Rust implementation is the supported operator path. If a command is missing
from Rust, stop and report the tooling gap instead of falling back to legacy
tooling.

Build local Rust executable:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov

Use release builds for normal agent/operator work. Use debug builds only when
actively debugging Rust internals:
  cargo build --manifest-path tooling/rust/Cargo.toml -p agov
EOF
    exit 0
    ;;
esac

if rust_supported "$@"; then
  run_rust "$@"
fi

cat >&2 <<EOF
agov: command not available in local Rust tooling.

If this is a supported command, build the Rust executable first:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov
  export PATH="\$PWD/tooling:\$PATH"

If the command is not yet implemented in Rust, stop and report the gap.
Do not use legacy tooling for routine agent or operator work.

Supported Rust commands:
  agov --version
  agov version [--format text|json]
  agov coord validate <file>...
  agov coord brief [--id-format ulid|readable] [--from <role>]
  agov coord post --from <role> --to <role> --kind <kind> --topic <topic>
  agov coord list [--since <message-id-or-timestamp>] [--format text|json]
  agov coord status [--dir <coord-dir>]
  agov coord stale [--dir <coord-dir>]
  agov coord visibility [--base-branch <branch>]
  agov coord graph [--dir <coord-dir>] [--format dot|text]
  agov coord graph-index [--dir <coord-dir>] [--output <file>]
  agov plan validate <file>...
  agov handoff next <agent-role> [--dir <coord-dir>]
  agov handoff take <handoff-id> --from <role> [--dir <coord-dir>]
  agov handoff complete <handoff-id> --from <role> [--to <role>] [--dir <coord-dir>]
  agov session resume [--role <agent-role>] [--base-branch <branch>]
  agov token roi report [--log <path>]
  agov usage report [--dir <coord-dir>] [--manifest <path>]
EOF
exit 127
