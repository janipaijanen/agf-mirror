#!/usr/bin/env sh
set -eu

script_path=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$0" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    script_path=$resolved
  fi
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
escript="$repo_root/tooling/elixir/agov"
rust_debug="$repo_root/tooling/rust/target/debug/agov"
rust_release="$repo_root/tooling/rust/target/release/agov"

export AGOV_SCHEMA_DIR="${AGOV_SCHEMA_DIR:-$repo_root/agf/schemas}"
export AGOV_MANIFEST_PATH="${AGOV_MANIFEST_PATH:-$repo_root/agf/agents/MANIFEST.yaml}"

rust_supported() {
  case "${1:-}" in
    coord)
      case "${2:-}" in
        validate|brief|status|stale) return 0 ;;
        visibility) return 0 ;;
      esac
      ;;
    plan)
      case "${2:-}" in
        validate) return 0 ;;
      esac
      ;;
    validate)
      return 0
      ;;
    handoff)
      case "${2:-}" in
        next) return 0 ;;
      esac
      ;;
    session)
      case "${2:-}" in
        resume) return 0 ;;
      esac
      ;;
    token)
      case "${2:-}:${3:-}" in
        roi:report) return 0 ;;
      esac
      ;;
    usage)
      case "${2:-}" in
        report) return 0 ;;
      esac
      ;;
    agov.coord.validate|agov.plan.validate|agov.session.resume|agov.token.roi|agov.usage.report)
      return 0
      ;;
  esac

  return 1
}

run_rust() {
  if [ -x "$rust_release" ]; then
    exec "$rust_release" "$@"
  fi

  if [ -x "$rust_debug" ]; then
    exec "$rust_debug" "$@"
  fi

  if command -v cargo >/dev/null 2>&1; then
    exec cargo run --quiet --manifest-path "$repo_root/tooling/rust/Cargo.toml" -p agov -- "$@"
  fi

  return 127
}

case "${1:-}" in
  -h|--help)
    cat <<EOF
Usage:
  agov coord validate <file>...
  agov coord brief [--id-format ulid|readable] [--from <role>] [--to <role>] [--kind <kind>] [--topic <topic>]
  agov coord status [--dir <coord-dir>] [--recent <n>] [--roles]
  agov coord stale [--dir <coord-dir>]
  agov coord visibility [--base-branch <branch>] [--branch <branch>] [--format text|json]
  agov plan validate <file>...
  agov agov.coord.validate <file>...
  agov agov.plan.validate <file>...
  agov validate [adoption|agents|learnings|infosec|contributions|framework-config]
  agov handoff next <agent-role> [--dir <coord-dir>]
  agov session resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov agov.session.resume [--role <agent-role>] [--base-branch <branch>] [--dir <coord-dir>]
  agov token roi report [--log <path>]
  agov agov.token.roi report [--log <path>]
  agov usage report [--dir <coord-dir>] [--manifest <path>] [--last <n>]
  agov agov.usage.report [--dir <coord-dir>] [--manifest <path>] [--last <n>]

Rust implementation is preferred for supported commands. Elixir/Mix remains the
fallback for commands not yet ported to Rust.

Build local Rust executable:
  cd tooling/rust && cargo build -p agov
EOF
    exit 0
    ;;
esac

if rust_supported "$@"; then
  run_rust "$@"
fi

if [ -x "$escript" ]; then
  if [ "${1:-}" = "coord" ] && command -v mix >/dev/null 2>&1; then
    if [ "${2:-}" = "validate" ]; then
      shift 2
      exec bash -c 'root=$1; shift; cwd=$PWD; args=(); for arg in "$@"; do case "$arg" in /*) args+=("$arg");; *) args+=("$cwd/$arg");; esac; done; cd "$root/tooling/elixir" && mix agov.coord.validate "${args[@]}"' bash "$repo_root" "$@"
    fi
    if [ "${2:-}" = "brief" ]; then
      shift 2
      exec sh -c 'root=$1; shift; cd "$root/tooling/elixir" && mix agov.coord.brief --dir "$root/docs/coordination" "$@"' sh "$repo_root" "$@"
    fi
  fi

  first_line=$(sed -n '1p' "$escript" 2>/dev/null || true)
  case "$first_line" in
    *escript*)
      if command -v escript >/dev/null 2>&1; then
        exec "$escript" "$@"
      fi
      if command -v mise >/dev/null 2>&1; then
        exec mise exec -- "$escript" "$@"
      fi
      ;;
    *)
      exec "$escript" "$@"
      ;;
  esac
fi

if command -v mix >/dev/null 2>&1; then
  case "${1:-}" in
    coord)
      shift
      if [ "${1:-}" = "validate" ]; then
        shift
        exec bash -c 'root=$1; shift; cwd=$PWD; args=(); for arg in "$@"; do case "$arg" in /*) args+=("$arg");; *) args+=("$cwd/$arg");; esac; done; cd "$root/tooling/elixir" && mix agov.coord.validate "${args[@]}"' bash "$repo_root" "$@"
      fi
      if [ "${1:-}" = "brief" ]; then
        shift
        exec sh -c 'root=$1; shift; cd "$root/tooling/elixir" && mix agov.coord.brief --dir "$root/docs/coordination" "$@"' sh "$repo_root" "$@"
      fi
      ;;
    plan)
      shift
      if [ "${1:-}" = "validate" ]; then
        shift
        exec sh -c 'cd "$1/tooling/elixir" && shift && mix agov.plan.validate "$@"' sh "$repo_root" "$@"
      fi
      ;;
    agov.coord.validate)
      shift
      exec sh -c 'cd "$1/tooling/elixir" && shift && mix agov.coord.validate "$@"' sh "$repo_root" "$@"
      ;;
    agov.plan.validate)
      shift
      exec sh -c 'cd "$1/tooling/elixir" && shift && mix agov.plan.validate "$@"' sh "$repo_root" "$@"
      ;;
  esac
fi

cat >&2 <<EOF
agov executable not available.

Build or install the Elixir agov executable, or run the Mix reference tasks
from tooling/elixir when Mix is available.

Expected local executable:
  tooling/elixir/agov

Supported launcher forms after build:
  agov coord validate <file>...
  agov plan validate <file>...
  agov agov.coord.validate <file>...
  agov agov.plan.validate <file>...
  agov agov.session.resume [--role <agent-role>]
  agov agov.token.roi report [--log <path>]
  agov agov.usage.report [--dir <coord-dir>] [--manifest <path>] [--last <n>]
EOF
exit 127
