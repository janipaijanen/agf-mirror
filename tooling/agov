#!/usr/bin/env sh
set -eu

script_path=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$0" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    script_path=$resolved
  fi
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
rust_debug="$repo_root/tooling/rust/target/debug/agov"
rust_release="$repo_root/tooling/rust/target/release/agov"
source_fingerprint_tool="$repo_root/tooling/rust/scripts/agov-source-fingerprint.sh"
freshness_paths="tooling/agov tooling/rust agf/schemas agf/agents/MANIFEST.yaml"

export AGOV_SCHEMA_DIR="${AGOV_SCHEMA_DIR:-$repo_root/agf/schemas}"
export AGOV_MANIFEST_PATH="${AGOV_MANIFEST_PATH:-$repo_root/agf/agents/MANIFEST.yaml}"

run_rust() {
  guard_invocation_worktree

  if [ "${AGOV_ALLOW_STALE_LOCAL_BINARY:-0}" = "1" ]; then
    if [ "${CI:-}" = "true" ]; then
      echo "agov: AGOV_ALLOW_STALE_LOCAL_BINARY is forbidden in CI" >&2
      return 126
    fi
    echo "WARN agov freshness gate explicitly bypassed for local development" >&2
    if [ -x "$rust_release" ]; then
      exec "$rust_release" "$@"
    fi
    if [ -x "$rust_debug" ]; then
      exec "$rust_debug" "$@"
    fi
  fi

  base_ref=$(requested_base_ref "$@")
  if [ ! -x "$source_fingerprint_tool" ]; then
    echo "agov: source fingerprint tool is missing or not executable: $source_fingerprint_tool" >&2
    return 127
  fi
  source_fingerprint=$($source_fingerprint_tool "$repo_root") || {
    echo "agov: failed to fingerprint tooling sources in $repo_root" >&2
    return 127
  }

  if [ -x "$rust_release" ] && binary_is_fresh "$rust_release" "$base_ref" "$source_fingerprint"; then
    exec "$rust_release" "$@"
  fi

  if [ -x "$rust_debug" ] && binary_is_fresh "$rust_debug" "$base_ref" "$source_fingerprint"; then
    exec "$rust_debug" "$@"
  fi

  if command -v cargo >/dev/null 2>&1; then
    echo "agov: rebuilding stale or missing repository-local release binary" >&2
    if AGOV_BUILD_SOURCE_FINGERPRINT="$source_fingerprint" \
      cargo build --quiet --release --locked \
        --manifest-path "$repo_root/tooling/rust/Cargo.toml" -p agov; then
      if [ -x "$rust_release" ] \
        && binary_is_fresh "$rust_release" "$base_ref" "$source_fingerprint"; then
        exec "$rust_release" "$@"
      fi
      echo "agov: rebuilt binary failed source compatibility verification" >&2
    else
      echo "agov: release rebuild failed" >&2
    fi
  fi

  cat >&2 <<EOF
agov: no provenance-compatible local binary is available.
Rebuild from the intended checkout, then retry:
  cargo build --release --manifest-path tooling/rust/Cargo.toml -p agov
EOF
  return 127
}

guard_invocation_worktree() {
  invocation_root=$(git -C "${PWD:-.}" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "$invocation_root" ] || [ "$invocation_root" = "$repo_root" ]; then
    return 0
  fi

  wrapper_common=$(git_common_dir "$repo_root" || true)
  invocation_common=$(git_common_dir "$invocation_root" || true)
  if [ -n "$wrapper_common" ] && [ "$wrapper_common" = "$invocation_common" ]; then
    cat >&2 <<EOF
agov: wrapper/worktree mismatch.
This wrapper belongs to:
  $repo_root/tooling/agov
Use the wrapper from the current worktree:
  $invocation_root/tooling/agov
EOF
    return 126
  fi
}

git_common_dir() {
  root=$1
  common=$(git -C "$root" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$common" in
    /*) common_path=$common ;;
    *) common_path=$root/$common ;;
  esac
  (CDPATH= cd -- "$common_path" 2>/dev/null && pwd)
}

requested_base_ref() {
  if [ "${1:-}" != "session" ] || [ "${2:-}" != "resume" ]; then
    return 0
  fi
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base-branch)
        [ "$#" -ge 2 ] && printf '%s\n' "$2"
        return 0
        ;;
      --base-branch=*)
        printf '%s\n' "${1#--base-branch=}"
        return 0
        ;;
    esac
    shift
  done
}

binary_is_fresh() {
  binary=$1
  # Safe shared value: base_ref is passed through unchanged by these helpers.
  base_ref=$2
  expected_fingerprint=$3
  provenance=$($binary version --format json 2>/dev/null || true)
  case "$provenance" in
    *'"commit":"'*'"source_fingerprint":"'*) ;;
    *) provenance='' ;;
  esac
  commit=${provenance#*'"commit":"'}
  commit=${commit%%\"*}
  embedded_fingerprint=${provenance#*'"source_fingerprint":"'}
  embedded_fingerprint=${embedded_fingerprint%%\"*}

  case "$commit" in
    ''|*[!0-9a-fA-F]*)
      echo "WARN rejected $binary: missing or malformed full commit provenance" >&2
      return 1
      ;;
  esac
  if [ "${#commit}" -ne 40 ]; then
    echo "WARN rejected $binary: missing or malformed full commit provenance" >&2
    return 1
  fi
  if [ "$embedded_fingerprint" != "$expected_fingerprint" ]; then
    echo "WARN rejected $binary: tooling source fingerprint differs" >&2
    return 1
  fi
  if ! head=$(git -C "$repo_root" rev-parse --verify "HEAD^{commit}" 2>/dev/null); then
    echo "WARN rejected $binary: cannot resolve worktree HEAD" >&2
    return 1
  fi
  if ! worktree_matches_binary "$commit" "$head"; then
    echo "WARN rejected $binary: stale relative to worktree HEAD" >&2
    return 1
  fi
  if [ -n "$base_ref" ] && ! base_matches_binary "$commit" "$base_ref"; then
    echo "WARN rejected $binary: stale relative to requested base $base_ref" >&2
    return 1
  fi
  return 0
}

worktree_matches_binary() {
  commit=$1
  target=$2
  if [ "$commit" = "$target" ]; then
    return 0
  fi
  git -C "$repo_root" merge-base --is-ancestor "$commit" "$target" 2>/dev/null \
    && git -C "$repo_root" diff --quiet "$commit" "$target" -- $freshness_paths
}

base_matches_binary() {
  commit=$1
  base_ref=$2
  if ! base=$(git -C "$repo_root" rev-parse --verify "$base_ref^{commit}" 2>/dev/null); then
    echo "WARN cannot resolve freshness target $base_ref" >&2
    return 1
  fi
  if [ "$base" = "$commit" ]; then
    return 0
  fi
  if git -C "$repo_root" merge-base --is-ancestor "$base" "$commit" 2>/dev/null; then
    return 0
  fi
  git -C "$repo_root" merge-base --is-ancestor "$commit" "$base" 2>/dev/null \
    && git -C "$repo_root" diff --quiet "$commit" "$base" -- $freshness_paths
}

run_rust "$@"
