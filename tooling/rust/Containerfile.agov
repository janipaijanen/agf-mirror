# Digest-pinned to the current Alpine 3.22 patch (3.22.5, verified
# 2026-07-21) after v2.3.0 release-readiness review found 19 fixed
# HIGH/CRITICAL CVEs in the previously pinned 3.22.1. Re-pin the digest
# (not just the tag) on future bumps: `podman manifest inspect
# alpine:3.22 --format ...` and take the multi-arch list digest, not a
# single-platform manifest digest.
FROM alpine:3.22.5@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG AGOV_VERSION
ARG AGOV_REVISION
ARG AGOV_SOURCE="https://gitlab.com/janipaijanen/agents-govern-framework"

LABEL org.opencontainers.image.title="agov" \
      org.opencontainers.image.description="AGF governance tooling CLI" \
      org.opencontainers.image.source="${AGOV_SOURCE}" \
      org.opencontainers.image.version="${AGOV_VERSION}" \
      org.opencontainers.image.revision="${AGOV_REVISION}" \
      org.opencontainers.image.licenses="CC-BY-SA-4.0 OR LicenseRef-AgentsGovern-Commercial"

RUN apk add --no-cache ca-certificates git \
    && addgroup -S agov \
    && adduser -S -G agov agov

COPY --chmod=0755 agov /usr/local/bin/agov

USER agov:agov
ENTRYPOINT ["agov"]
